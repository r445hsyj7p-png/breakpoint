# Wird automatisch von "vite build" geladen (Vite-Mode "production").
# Leer = relative Pfade ("/api/...") — das Produktions-nginx (nginx.conf)
# proxied /api/ zum Backend-Service, dieselbe Origin wie das Frontend selbst.
# Lokale Entwicklung (npm run dev) lädt diese Datei nicht und behält den
# Default aus src/lib/api.ts (http://127.0.0.1:8000).
VITE_API_BASE_URL=
