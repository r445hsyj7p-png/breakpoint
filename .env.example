# Postgres (Service 'db' in infra/docker-compose.yml)
POSTGRES_USER=breakpoint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=breakpoint

# Backend
DATABASE_URL=postgresql+psycopg://breakpoint:change-me@db:5432/breakpoint

# Vorbereitet für Schritt 5 (PydanticAI gegen die interne LLM-Plattform) — in
# Schritt 1 noch nicht funktional genutzt, siehe docs/projektauftrag.md Abschnitt 7.
LLM_PLATFORM_BASE_URL=

# Nur für infra/docker-compose.prod.yml (VPS-Deploy, Abschnitt 10h) relevant:
# öffentlich erreichbarer Port des nginx/frontend-Service. Standard 80.
# PUBLIC_HTTP_PORT=80
